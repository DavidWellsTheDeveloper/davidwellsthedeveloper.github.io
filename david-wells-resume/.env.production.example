# Copy to `.env.production` (gitignored) for `make deploy-aws`.
# Never commit real credentials.

AWS_REGION=us-east-1
AWS_S3_BUCKET=david-wells-portfolio

# Recommended: use an IAM role + CLI profile (see deploy/AWS-SETUP.md section 2)
# AWS_PROFILE=portfolio-deploy

# Alternative: long-lived keys on a user that has the S3 policy (not the assume-role pattern)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: if you use CloudFront in front of this bucket
# AWS_CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
