.local
local.config.*

# Database
*.sqlite
*.db

# Backup files
*.backup
*.bak
*.orig

# Resume-specific ignores
# Ignore any personal files accidentally added
personal/
private/
confidential/

# Development tools
.history/
.vscode/settings.json

