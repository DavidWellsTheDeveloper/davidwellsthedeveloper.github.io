{
  "name": "david-wells-resume",
  "version": "1.0.0",
  "description": "Professional digital resume website for David T. Wells",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "nuxt typecheck",
    "quality": "npm run lint && npm run format:check && npm run test:run",
    "deploy:aws": "./deploy/aws-s3.sh",
    "deploy:preview": "npm run generate && npm run preview",
    "setup:domain": "../setup-free-https.sh",
    "constitutional:check": "npm run test:run && npm run lint && echo '✅ Constitutional compliance verified'"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.6.5",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/eslint-config": "^0.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "happy-dom": "^19.0.2",
    "nuxt": "^3.19.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^1.8.27"
  },
  "dependencies": {
    "@nuxt/content": "^2.13.4",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/tailwindcss": "^6.14.0"
  }
}
