# Environment Configuration for David Wells Digital Resume
# Copy this file to .env and update with your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application environment (development, staging, production)
NODE_ENV=development

# Application URL (used for SEO, social sharing, etc.)
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Application name and branding
NUXT_PUBLIC_APP_NAME="David T. Wells - Digital Resume"
NUXT_PUBLIC_APP_DESCRIPTION="Professional digital resume for David T. Wells — data platforms, analytics, and full-stack software engineering"

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable development tools
NUXT_DEV_TOOLS=true

# Development port (optional, defaults to 3000)
PORT=3000

# =============================================================================
# ANALYTICS & TRACKING (Optional)
# =============================================================================

# Google Analytics 4 Measurement ID
# NUXT_PUBLIC_GOOGLE_ANALYTICS=G-XXXXXXXXXX

# Google Tag Manager ID
# NUXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# =============================================================================
# CONTACT & SOCIAL (Public - safe to expose to client)
# =============================================================================

# Contact information (these will be public)
NUXT_PUBLIC_EMAIL=your.email@example.com
NUXT_PUBLIC_PHONE="+1-555-123-4567"
NUXT_PUBLIC_LOCATION="Your City, State"

# Social media profiles (optional)
# NUXT_PUBLIC_LINKEDIN=https://linkedin.com/in/your-profile
# NUXT_PUBLIC_GITHUB=https://github.com/your-username
# NUXT_PUBLIC_TWITTER=https://twitter.com/your-handle

# =============================================================================
# CONTENT MANAGEMENT (Optional)
# =============================================================================

# Content API endpoints (if using headless CMS)
# CONTENT_API_URL=https://your-cms.com/api
# CONTENT_API_KEY=your-api-key

# =============================================================================
# EMAIL & CONTACT FORM (Server-side - keep private)
# =============================================================================

# Email service configuration (for contact forms)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Alternative: Email service API keys
# SENDGRID_API_KEY=your-sendgrid-key
# MAILGUN_API_KEY=your-mailgun-key
# RESEND_API_KEY=your-resend-key

# =============================================================================
# DEPLOYMENT & HOSTING
# =============================================================================

# AWS S3 configuration (for static hosting via `make deploy-aws` / npm run deploy:aws)
# Copy this file to .env.production and uncomment — .env.production is gitignored.
# Requires AWS CLI. IAM needs s3:PutObject, s3:DeleteObject, s3:ListBucket on the bucket,
# plus s3:PutBucketWebsite; for CloudFront add CreateInvalidation + GetDistribution.
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-resume-bucket
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# CloudFront distribution (optional — omit to skip cache invalidation)
# AWS_CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id

# =============================================================================
# SECURITY & PERFORMANCE
# =============================================================================

# Security headers configuration
NUXT_PUBLIC_CSP_ENABLED=true

# Rate limiting (if implementing contact forms)
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# MONITORING & LOGGING (Optional)
# =============================================================================

# Error tracking (Sentry, LogRocket, etc.)
# SENTRY_DSN=your-sentry-dsn
# LOGROCKET_APP_ID=your-logrocket-id

# Performance monitoring
# NEW_RELIC_LICENSE_KEY=your-newrelic-key
# DATADOG_API_KEY=your-datadog-key

# =============================================================================
# CONSTITUTIONAL COMPLIANCE
# =============================================================================

# Feature flags for constitutional principles
NUXT_PUBLIC_AUTHENTIC_REPRESENTATION=true
NUXT_PUBLIC_CLEAN_DESIGN=true
NUXT_PUBLIC_FAST_LOADING=true

# Performance targets (milliseconds)
NUXT_PUBLIC_TARGET_LOAD_TIME=3000
NUXT_PUBLIC_TARGET_FCP=1500
NUXT_PUBLIC_TARGET_LCP=2500

# =============================================================================
# TESTING & CI/CD
# =============================================================================

# Test environment settings
# TEST_DATABASE_URL=sqlite://test.db
# CI=true

# =============================================================================
# NOTES
# =============================================================================
# 
# NUXT_PUBLIC_* variables are exposed to the client-side code
# Variables without NUXT_PUBLIC_ prefix are server-side only
# 
# For production deployment:
# 1. Copy this file to .env
# 2. Update all placeholder values
# 3. Ensure .env is in .gitignore (it should be)
# 4. Use your hosting platform's environment variable settings
#
# Constitutional Principles:
# - Only include variables that serve authentic representation
# - Keep configuration clean and purposeful
# - Optimize for fast loading and user experience
# - Maintain deployment readiness